datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  name      String   @default("Admin")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Listing {
  id              Int            @id @default(autoincrement())
  category        String         // 'HOUSE' | 'CAR'
  title           String
  description     String
  price           Float
  priceUnit       String         @default("month") // 'day' | 'month' | 'year'
  status          String         @default("AVAILABLE") // 'AVAILABLE' | 'RENTED'
  rentalStartDate DateTime?
  rentalEndDate   DateTime?
  locationName    String         // e.g. "เชียงใหม่ หางดง", "กรุงเทพฯ สุขุมวิท"
  address         String?
  latitude        Float          @default(13.7563) // Default Bangkok coordinates
  longitude       Float          @default(100.5018)
  contactName     String         @default("Admin Rental")
  contactPhone    String
  contactLine     String?
  contactFacebook String?
  images          ListingImage[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model ListingImage {
  id        Int      @id @default(autoincrement())
  listingId Int
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  url       String
  isCover   Boolean  @default(false)
  createdAt DateTime @default(now())
}
